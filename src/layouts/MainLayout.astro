---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { Font } from "astro:assets";

interface Props {
  title: string;
  description?: string;
  navbarScrolled?: boolean;
  /** Override the canonical URL path (defaults to current pathname). */
  canonical?: string;
  /** Set true on pages where indexing is unwanted (e.g. admin). */
  noindex?: boolean;
}

const {
  title,
  description = "Κατερίνα Κρητικού — Σύμβουλος Ψυχικής Υγείας, Mindfulness Instructor & Yoga Teacher. Ατομικές συνεδρίες, συμβουλευτική ζευγαριών, διαχείριση άγχους. Ηλιούπολη, Αθήνα.",
  navbarScrolled,
  canonical,
  noindex = false,
} = Astro.props;

const SITE = "https://katerinakritikou.gr";
const canonicalURL = new URL(canonical ?? Astro.url.pathname, SITE).href;

// LocalBusiness structured data for rich results (local SEO).
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Psychologist",
  "@id": `${SITE}/#psychologist`,
  name: "Κατερίνα Κρητικού",
  description,
  url: SITE,
  image: `${SITE}/og.jpg`,
  logo: `${SITE}/logo.png`,
  telephone: "+306974210321",
  email: "katkritikou1968@gmail.com",
  priceRange: "€€",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Βύρωνος 13, 2ος όροφος (εντός εμπορικού κέντρου)",
    addressLocality: "Ηλιούπολη",
    postalCode: "16342",
    addressRegion: "Αττική",
    addressCountry: "GR",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: 37.93105398341229,
    longitude: 23.756774723212008,
  },
  hasMap: "https://maps.app.goo.gl/YvLzjySg75LaQXCb8",
  areaServed: "Ηλιούπολη, Αθήνα",
  medicalSpecialty: ["Psychiatric", "Psychotherapeutic"],
  availableService: [
    "Ατομικές Συνεδρίες",
    "Συμβουλευτική Ζευγαριών & Σχέσεων",
    "Διαχείριση Κρίσεων Πανικού & Άγχους",
    "Mindfulness",
  ],
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday"],
      opens: "08:30",
      closes: "12:30",
    },
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday"],
      opens: "18:30",
      closes: "22:30",
    },
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Friday"],
      opens: "08:30",
      closes: "13:30",
    },
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Friday"],
      opens: "15:30",
      closes: "22:30",
    },
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Saturday"],
      opens: "10:30",
      closes: "14:30",
    },
  ],
  sameAs: [
    "https://www.instagram.com/__katerinakritikou__/",
    "https://www.facebook.com/p/%CE%9A%CE%B1%CF%84%CE%B5%CF%81%CE%AF%CE%BD%CE%B1-%CE%9A%CF%81%CE%B7%CF%84%CE%B9%CE%BA%CE%BF%CF%8D-100004593438140/",
    "https://www.tiktok.com/@_katerina_kritikou_",
  ],
  knowsAbout: [
    "Συμβουλευτική Ψυχικής Υγείας",
    "Mindfulness",
    "Διαχείριση Κρίσεων Πανικού & Άγχους",
    "Συμβουλευτική Ζευγαριών & Σχέσεων",
    "Yoga",
  ],
};
---

<html lang="el">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* Google Search requires a raster favicon that is a multiple of 48px (or SVG). */}
    <link rel="icon" type="image/png" sizes="144x144" href="/favicon-144.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0b1a3a" />
    <Font cssVariable="--font-google" preload />
    <Font cssVariable="--font-source-serif" preload />
    <ClientRouter />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="el_GR" />
    <meta property="og:site_name" content="Κατερίνα Κρητικού | Ψυχολόγος" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={`${SITE}/og.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Κατερίνα Κρητικού — Σύμβουλος Ψυχικής Υγείας" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE}/og.jpg`} />
    <meta name="twitter:image:alt" content="Κατερίνα Κρητικού — Σύμβουλος Ψυχικής Υγείας" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <script>
      // Mark pages arriving via client-router so the navbar entrance animation
      // (nav-drop / blur-in) can be skipped — it should only play on first load.
      document.addEventListener("astro:before-swap", (e) => {
        e.newDocument.documentElement.classList.add("astro-vt-nav");
      });
    </script>

    <noscript>
      <style>
        .home-reveal, .about-reveal, .service-reveal, .faq-reveal, .contact-reveal,
        .animate-nav-drop, .animate-blur-in, .animate-fade-in-up, .animate-slow-zoom, .animate-step {
          opacity: 1 !important;
          transform: none !important;
          filter: none !important;
          animation: none !important;
        }
      </style>
    </noscript>
  </head>
  <body class="flex flex-col min-h-screen" {...navbarScrolled && { "data-navbar-scrolled": "" }}>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-[100] focus:px-4 focus:py-2 focus:bg-dark-900 focus:text-white focus:rounded">
      Παράκαμψη προς περιεχόμενο
    </a>
    <Navbar />
    <main id="main" class="relative z-10 shadow-2xl shadow-black/20 grow bg-dark-900">
      <slot />
    </main>
    <Footer />
  </body>
</html>
