---
import "../styles/global.css";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-google" preload />
    <Font cssVariable="--font-noto" preload />
    <ClientRouter />
    <title>{title}</title>
  </head>
  <body class="bg-stone-50 min-h-screen">
    <header class="flex items-center justify-between px-4 md:px-6 pt-4">
      <a href="/admin/bookings">
        <img src="/logo.png" alt="Logo" class="h-15" />
      </a>
      <button
        id="logout-btn"
        type="button"
        class="inline-flex items-center gap-1.5 text-sm font-medium text-neutral-400 hover:text-red-600 border border-transparent hover:border-red-200 rounded-full px-4 py-1.5 transition-all cursor-pointer"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M3 4.25A2.25 2.25 0 015.25 2h5.5A2.25 2.25 0 0113 4.25v2a.75.75 0 01-1.5 0v-2a.75.75 0 00-.75-.75h-5.5a.75.75 0 00-.75.75v11.5c0 .414.336.75.75.75h5.5a.75.75 0 00.75-.75v-2a.75.75 0 011.5 0v2A2.25 2.25 0 0110.75 18h-5.5A2.25 2.25 0 013 15.75V4.25z" clip-rule="evenodd"></path>
          <path fill-rule="evenodd" d="M6 10a.75.75 0 01.75-.75h9.546l-1.048-.943a.75.75 0 111.004-1.114l2.5 2.25a.75.75 0 010 1.114l-2.5 2.25a.75.75 0 11-1.004-1.114l1.048-.943H6.75A.75.75 0 016 10z" clip-rule="evenodd"></path>
        </svg>
        Αποσύνδεση
      </button>
    </header>
    <slot />
  </body>
</html>

<script>
  document.addEventListener("astro:page-load", () => {
    document.getElementById("logout-btn")?.addEventListener("click", async () => {
      try {
        const res = await fetch("/api/admin-logout", { method: "POST" });
        if (!res.ok) throw new Error();
        window.location.href = "/admin/login";
      } catch {
        alert("Αποσύνδεση απέτυχε. Δοκιμάστε ξανά.");
      }
    });
  });
</script>
