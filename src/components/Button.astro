---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'nav';
  className?: string;
  [key: string]: any; // To allow for extra attributes like target, id, etc.
}

const { 
  href, 
  variant = 'primary', 
  className, 
  ...rest 
} = Astro.props;

const baseStyles = "px-7 text-sm font-semibold transition-colors duration-200 cursor-pointer min-h-[44px] inline-flex items-center";

const variants = {
  primary: " bg-primary-700 text-white hover:bg-primary-800 hover:text-white py-3",
  secondary: "bg-accent-500 text-dark-900 hover:bg-accent-600 hover:text-dark-900 py-3",
  nav: "nav-btn bg-dark-900 text-white hover:bg-primary-800 py-2"
};

const Element = href ? 'a' : 'button';
---

<Element 
  href={href} 
  class:list={[baseStyles, variants[variant], className]} 
  {...rest}
>
  <slot />
</Element>