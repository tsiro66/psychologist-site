---
import { Image } from "astro:assets";
import aboutImage from "../assets/about.png";
import Button from "./Button.astro";

const credentials = [
  {
    label: "Πτυχίο Ψυχολογίας",
    detail: "Εθνικό & Καποδιστριακό Πανεπιστήμιο Αθηνών",
  },
  {
    label: "Μεταπτυχιακό Κλινικής Ψυχολογίας",
    detail: "Πανεπιστήμιο Αθηνών",
  },
  {
    label: "Πιστοποίηση Γνωσιακής-Συμπεριφορικής Θεραπείας",
    detail: "CBT Institute",
  },
];

const values = [
  {
    title: "Εμπιστοσύνη",
    description:
      "Η θεραπευτική σχέση βασίζεται στην αμοιβαία εμπιστοσύνη και τον σεβασμό. Κάθε συνεδρία είναι ένας ασφαλής χώρος για εσένα.",
  },
  {
    title: "Ενσυναίσθηση",
    description:
      "Ακούω με προσοχή και κατανοώ τη μοναδική σου εμπειρία, χωρίς κριτική ή επιφανειακές λύσεις.",
  },
  {
    title: "Επιστημονική προσέγγιση",
    description:
      "Χρησιμοποιώ τεκμηριωμένες θεραπευτικές μεθόδους, προσαρμοσμένες στις ατομικές σου ανάγκες.",
  },
];
---

<section id="about" class="relative py-16 md:py-28 px-4 md:px-6 bg-primary-50">
  <div class="max-w-6xl mx-auto">
    <!-- Section Header -->
    <div class="mb-20">
      <span
        class="inline-block text-sm tracking-widest uppercase text-primary-600 font-semibold mb-4 about-reveal opacity-0"
      >
        Σχετικα
      </span>
      <h2
        class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-serif text-neutral-950 leading-tight about-reveal opacity-0"
        style="animation-delay: 0.1s;"
      >
        Λίγα λόγια <span class="text-primary-700 italic">για εμένα</span>
      </h2>
      <p
        class="mt-5 text-neutral-500 max-w-2xl leading-relaxed about-reveal opacity-0"
        style="animation-delay: 0.2s;"
      >
        Πιστεύω ότι κάθε άνθρωπος αξίζει έναν ασφαλή χώρο για να εξερευνήσει
        τον εαυτό του και να βρει τη δύναμή του.
      </p>
    </div>

    <!-- Image + Credentials -->
    <div
      class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-start mb-12"
    >
      <div class="about-reveal opacity-0" style="animation-delay: 0.25s;">
        <Image
          src={aboutImage}
          alt="Κατερίνα Κρητικού"
          class="w-full aspect-[3/2] object-cover shadow-xl shadow-stone-400/30"
          quality="high"
          width={600}
        />
      </div>

      <!-- Credentials -->
      <div class="flex flex-col gap-4">
        <h3 class="text-2xl font-serif text-neutral-950 mb-2 about-reveal opacity-0" style="animation-delay: 0.3s;">
          Κατερίνα Κρητικού
        </h3>
        {
          credentials.map((cred, i) => (
            <div
              class="p-6 border border-stone-200 bg-white shadow-md shadow-stone-200/50 about-reveal opacity-0"
              style={`animation-delay: ${0.35 + i * 0.1}s;`}
            >
              <span class="block text-sm font-semibold text-neutral-950 mb-1">
                {cred.label}
              </span>
              <span class="text-sm text-neutral-500">{cred.detail}</span>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Bio (full width) -->
    <div
      class="space-y-4 text-sm md:text-base text-neutral-600 leading-relaxed mb-20 about-reveal opacity-0"
      style="animation-delay: 0.5s;"
    >
      <p>
        Είμαι κλινική ψυχολόγος με πάθος για τη βαθύτερη κατανόηση του
        ανθρώπινου νου. Από τα πρώτα χρόνια των σπουδών μου, με γοήτευσε η
        δυνατότητα της ψυχοθεραπείας να μεταμορφώσει ζωές.
      </p>
      <p>
        Η θεραπευτική μου προσέγγιση συνδυάζει τεχνικές γνωσιακής-συμπεριφορικής
        θεραπείας με στοιχεία ψυχοδυναμικής κατανόησης, προσαρμοσμένα πάντα στις
        μοναδικές ανάγκες κάθε ατόμου.
      </p>
      <p>
        Στόχος μου είναι να δημιουργήσω έναν χώρο ασφάλειας και αποδοχής,
        όπου μπορείς να εξερευνήσεις τις σκέψεις και τα συναισθήματά σου
        χωρίς κριτική.
      </p>
    </div>

    <!-- Values -->
    <div>
      <h3
        class="text-2xl font-serif text-neutral-950 text-center mb-12 about-reveal opacity-0"
        style="animation-delay: 0.4s;"
      >
        Οι αξίες μου
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {
          values.map((value, i) => (
            <div
              class="p-8 bg-gradient-to-br from-primary-700 to-dark-800 text-white shadow-xl shadow-primary-300/30 about-reveal opacity-0"
              style={`animation-delay: ${0.45 + i * 0.1}s;`}
            >
              <h4 class="text-lg font-semibold mb-3">{value.title}</h4>
              <p class="text-sm text-primary-200 leading-relaxed">
                {value.description}
              </p>
            </div>
          ))
        }
      </div>
    </div>

    <!-- CTA -->
    <div
      class="text-center mt-16 about-reveal opacity-0"
      style="animation-delay: 0.75s;"
    >
      <Button href="/booking" variant="primary">Κλείσε δωρεάν συνεδρία γνωριμίας</Button>
    </div>
  </div>
</section>

<style>
  @keyframes aboutReveal {
    from {
      filter: blur(8px);
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      filter: blur(0);
      opacity: 1;
      transform: translateY(0);
    }
  }

  .about-reveal.is-visible {
    animation: aboutReveal 0.9s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const aboutObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            aboutObserver.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1 }
    );

    document.querySelectorAll(".about-reveal").forEach((el) => {
      aboutObserver.observe(el);
    });
  });
</script>
