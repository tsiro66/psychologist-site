---
import { Image } from "astro:assets";
import aboutImage from "../assets/about.png";
import Button from "./Button.astro";

type Credential = { label: string; detail: string | string[] };

const credentials: Credential[] = [
  {
    label: "European University Cyprus",
    detail: "Ψυχολογία (παρόν)",
  },
  {
    label: "Κέντρο Εφαρμοσμένης Ψυχοθεραπείας & Συμβουλευτικής Αθηνών",
    detail: [
      "Δίπλωμα στη Συμβουλευτική Ψυχικής Υγείας.",
      "Παρατήρηση ομάδας αυτογνωσίας: συμπεριφορά ατόμων, ανάλυση χαρακτήρων, παρατήρηση συγκρούσεων, συναισθηματική κατάσταση, συμπεριφορά μέσα στην ομάδα.",
    ],
  },
  {
    label: "Ε.Κ.Π.Α.",
    detail: [
      "Γνωσιακή Συμπεριφοριστική Θεραπεία: θεωρία και κλινική πράξη.",
      "Διαχείριση Συναισθηματικού & Ψυχικού Τραύματος.",
      "Όταν ένας γάμος διαλύεται: διαζύγιο, διαχείριση γονικών συγκρούσεων, λήψη αποφάσεων, προγραμματισμός γονεϊκής φροντίδας, περίοδος χάριτος.",
    ],
  },
  {
    label: "Δέντρο Θεραπείας Ι.Κ.Ε.",
    detail: "Κλινική ψυχιατρική αξιολόγηση.",
  },
  {
    label: "One Breath Mindfulness Center",
    detail: "M.B.S.R. — Mindfulness-Based Stress Reduction.",
  },
  {
    label: "Ison Psychometrica",
    detail: "Total Mindfulness Professional.",
  },
  {
    label: "Ελληνική Εταιρεία Συμβουλευτικής",
    detail: "Διημερίδα Ε.Ε.Σ. — Φόβος: ατομικός / συλλογικός.",
  },
  {
    label: "Unisert Professional",
    detail:
      "Πρόγραμμα υποστήριξης και παρέμβασης στις ειδικές μαθησιακές δυσκολίες.",
  },
  {
    label: "Play Therapy Greece",
    detail:
      "Circle of Security Parenting — Attachment (πρόγραμμα 15 ωρών και 2 τρίωρων συναντήσεων στο attachment των ενηλίκων).",
  },
  {
    label: "Marte Meo",
    detail:
      "Γνωριμία με τη μέθοδο: ενίσχυση αυτοπεποίθησης, θετική καθοδήγηση, δεξιότητες παιχνιδιού, σχολική ετοιμότητα.",
  },
  {
    label: "Yoga",
    detail: "Family Violet Alignment — 200hr Yoga Teacher Training.",
  },
  {
    label: "City Unity College — Στιγμές Σπουδές",
    detail: [
      "Σκιαγραφώντας θύτες και θύματα γυναικοκτονιών.",
      "Άγχος, κρίσεις πανικού και γνωσιακή συμπεριφοριστική θεραπεία.",
      "Ιδιοσυγκρασιακή διατροφή: από τη θεωρία στην πράξη.",
      "Μουσικοθεραπεία: θεωρία και εφαρμογές.",
      "Σχεδιασμός και συντονισμός ψυχοεκπαιδευτικών ομάδων.",
    ],
  },
];

const values = [
  {
    title: "Σεβασμός στην ατομικότητα",
    description:
      "Κάθε άνθρωπος είναι μοναδικός. Προσεγγίζω τις ανάγκες και τις εσωτερικές αναζητήσεις των συμβουλευομένων με απόλυτο σεβασμό και χωρίς κριτική.",
  },
  {
    title: "Ενσυναίσθηση και αυθεντική σύνδεση",
    description:
      "Πιστεύω στη δύναμη της θεραπευτικής σχέσης και της αλληλεπίδρασης. Στέκομαι με υπομονή και βαθιά κατανόηση σε όσους βιώνουν κρίσεις, απώλειες ή μεταβατικές περιόδους στη ζωή τους.",
  },
  {
    title: "Ολιστική ευεξία",
    description:
      "Συνδυάζω την συμβουλευτική ψυχολογία με την ενσυνειδητότητα (mindfulness) και την yoga, αντιμετωπίζοντας τον άνθρωπο ως μια ενότητα νου, σώματος και συναισθήματος.",
  },
  {
    title: "Συνεχής εξέλιξη",
    description:
      "Η δέσμευσή μου στη δια βίου μάθηση, στην προσωπική ψυχοθεραπεία και την κλινική επίβλεψη διασφαλίζει την επιστημονική και ηθική ακεραιότητα των υπηρεσιών μου.",
  },
];
---

<section id="about" class="relative py-16 md:py-28 px-4 md:px-6 bg-primary-50">
  <div class="max-w-6xl mx-auto">
    <!-- Section Header -->
    <div class="mb-20">
      <span
        class="inline-block text-sm tracking-widest uppercase text-primary-600 font-semibold mb-4 about-reveal opacity-0"
      >
        Σχετικά
      </span>
      <h2
        class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-serif text-neutral-950 leading-tight about-reveal opacity-0"
        style="animation-delay: 0.1s;"
      >
        Λίγα λόγια <span class="text-primary-700 italic">για εμένα</span>
      </h2>
      <p
        class="mt-5 text-neutral-500 max-w-2xl leading-relaxed about-reveal opacity-0"
        style="animation-delay: 0.2s;"
      >
        Ως Σύμβουλος Ψυχικής Υγείας, Mindfulness Instructor και Yoga Teacher, η
        προσέγγισή μου είναι βαθιά ανθρωποκεντρική και ολιστική. Κεντρικός μου
        στόχος είναι η ενδυνάμωση των ανθρώπων ώστε να διεκδικήσουν μια πιο υγιή,
        ισορροπημένη και δημιουργική ζωή.
      </p>
    </div>

    <!-- Image + Intro -->
    <div
      class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center mb-20"
    >
      <div class="about-reveal opacity-0" style="animation-delay: 0.25s;">
        <Image
          src={aboutImage}
          alt="Κατερίνα Κρητικού"
          class="w-full aspect-[3/2] object-cover shadow-xl shadow-stone-400/30"
          quality="high"
          width={600}
        />
      </div>

      <div
        class="space-y-4 text-sm md:text-base text-neutral-600 leading-relaxed about-reveal opacity-0"
        style="animation-delay: 0.3s;"
      >
        <p>
          Καλώς ήρθες, είμαι η Κατερίνα Κρητικού. Πιστεύω βαθιά ότι η ψυχική
          ισορροπία δεν είναι η απουσία δυσκολιών, αλλά η ικανότητά μας να
          παραμένουμε σταθεροί και γαλήνιοι μέσα σε αυτές. Ως Σύμβουλος Ψυχικής
          Υγείας, Mindfulness Instructor και Yoga Teacher, η προσέγγισή μου είναι
          ολιστική.
        </p>
        <p>
          Συνδυάζω την συμβουλευτική ψυχολογία με την συνειδητή αναπνοή και την
          σοφία του σώματος, βοηθώντας σε να απελευθερώσεις το άγχος, να
          διαχειριστείς το παρόν σου και να επανασυνδεθείς με τον αυθεντικό εαυτό
          σου.
        </p>
        <p>
          Εδώ, σε έναν ασφαλή χώρο χωρίς κριτική, είμαι δίπλα σου για να
          περπατήσουμε μαζί τη δική σου διαδρομή προς την προσωπική ανάπτυξη, την
          αυτοεκτίμηση και την εσωτερική σου γαλήνη.
        </p>
      </div>
    </div>

    <!-- Studies -->
    <div class="mb-20">
      <h3
        class="text-2xl font-serif text-neutral-950 mb-10 about-reveal opacity-0"
        style="animation-delay: 0.35s;"
      >
        Σπουδές
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {
          credentials.map((cred, i) => (
            <div
              class="p-6 border border-stone-200 bg-white shadow-md shadow-stone-200/50 about-reveal opacity-0"
              style={`animation-delay: ${0.4 + i * 0.08}s;`}
            >
              <span class="block text-sm font-semibold text-neutral-950 mb-2">
                {cred.label}
              </span>
              {Array.isArray(cred.detail) ? (
                <ul class="space-y-1.5">
                  {cred.detail.map((d) => (
                    <li class="text-sm text-neutral-500 leading-relaxed flex items-start gap-2">
                      <span class="mt-1.5 w-1 h-1 rounded-full bg-primary-400 flex-shrink-0"></span>
                      <span>{d}</span>
                    </li>
                  ))}
                </ul>
              ) : (
                <span class="text-sm text-neutral-500 leading-relaxed">
                  {cred.detail}
                </span>
              )}
            </div>
          ))
        }
      </div>
    </div>

    <!-- Values -->
    <div>
      <h3
        class="text-2xl font-serif text-neutral-950 text-center mb-12 about-reveal opacity-0"
        style="animation-delay: 0.4s;"
      >
        Οι αξίες μου
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {
          values.map((value, i) => (
            <div
              class="p-8 bg-gradient-to-br from-primary-700 to-dark-800 text-white shadow-xl shadow-primary-300/30 about-reveal opacity-0"
              style={`animation-delay: ${0.45 + i * 0.1}s;`}
            >
              <h4 class="text-lg font-semibold mb-3">{value.title}</h4>
              <p class="text-sm text-primary-200 leading-relaxed">
                {value.description}
              </p>
            </div>
          ))
        }
      </div>
    </div>

    <!-- CTA -->
    <div
      class="text-center mt-16 about-reveal opacity-0"
      style="animation-delay: 0.75s;"
    >
      <Button href="/booking" variant="primary">Κλείσε ραντεβού</Button>
    </div>
  </div>
</section>

<style>
  @keyframes aboutReveal {
    from {
      filter: blur(8px);
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      filter: blur(0);
      opacity: 1;
      transform: translateY(0);
    }
  }

  .about-reveal.is-visible {
    animation: aboutReveal 0.9s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const aboutObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            aboutObserver.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1 }
    );

    document.querySelectorAll(".about-reveal").forEach((el) => {
      aboutObserver.observe(el);
    });
  });
</script>
