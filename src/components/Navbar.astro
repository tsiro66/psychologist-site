---
import Image from "astro/components/Image.astro";
import Button from "./Button.astro";
const navLinks = [
  { label: "Σχετικά", href: "/about" },
  { label: "Υπηρεσίες", href: "/services" },
  { label: "Συχνές ερωτήσεις", href: "/faq" },
  { label: "Επικοινωνία", href: "/contact" },
];
---

<header
  class="navbar fixed top-0 left-0 right-0 px-4 md:px-10 py-3 z-50 transition-all duration-500 animate-nav-drop opacity-0"
  style="animation-fill-mode: forwards;"
>
  <nav class="flex items-center justify-between">
    <a
      href="/"
      class="relative flex flex-col hover:opacity-80 transition-opacity"
    >
      <!-- green (original) — shown when scrolled -->
      <Image
        src="/logo.png"
        alt="Logo"
        width={150}
        height={150}
        class="logo-green opacity-0 transition-opacity duration-500 [filter:hue-rotate(150deg)_saturate(2)]"
      />
      <!-- purple — shown when at top -->
      <Image
        src="/logo.png"
        alt=""
        width={150}
        height={150}
        class="logo-purple absolute inset-0 [filter:hue-rotate(150deg)_saturate(18)] opacity-100 transition-opacity duration-500"
      />
    </a>

    <ul class="hidden lg:flex items-center gap-8 lg:pl-8">
      {
        navLinks.map((link, i) => (
          <li
            class="animate-blur-in opacity-0"
            style={`animation-delay: ${0.2 + i * 0.1}s; animation-fill-mode: forwards;`}
          >
            <a
              href={link.href}
              class="nav-link text-zinc-950 hover:text-lime-700 transition-colors duration-500"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-4">
      <div
        class="hidden md:block animate-blur-in opacity-0"
        style="animation-delay: 0.8s; animation-fill-mode: forwards;"
      >
        <Button href="/booking" variant="nav">Δωρεάν συνεδρία γνωριμίας</Button>
      </div>

      <!-- Mobile hamburger -->
      <button
        class="mobile-menu-toggle lg:hidden flex flex-col items-center justify-center w-11 h-11 gap-2 cursor-pointer"
        aria-label="Μενού πλοήγησης"
        aria-expanded="false"
      >
        <span
          class="hamburger-line w-8 h-0.5 bg-zinc-950 transition-all duration-300 origin-center"
        ></span>
        <span
          class="hamburger-line w-8 h-0.5 bg-zinc-950 transition-all duration-300 origin-center"
        ></span>
      </button>
    </div>
  </nav>
</header>

<!-- Fullscreen mobile menu -->
<div
  class="mobile-menu fixed inset-0 z-40 bg-violet-950 lg:hidden hidden flex-col justify-center items-center"
>
  <ul class="flex flex-col items-center gap-2">
    {
      navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class="mobile-nav-link block py-3 px-4 text-2xl font-semibold text-violet-300 hover:text-lime-400 transition-colors duration-300"
          >
            {link.label}
          </a>
        </li>
      ))
    }
    <li class="pt-6">
      <Button
        href="/booking"
        variant="nav"
        className="text-center justify-center px-10 py-3"
        >Δωρεάν συνεδρία γνωριμίας</Button
      >
    </li>
  </ul>
</div>

<style>
  @reference "../styles/global.css";
  @keyframes navDrop {
    from {
      transform: translateY(-20px);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  @keyframes blurIn {
    from {
      filter: blur(8px);
      opacity: 0;
      transform: translateY(5px);
    }
    to {
      filter: blur(0);
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-nav-drop {
    animation: navDrop 1s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .animate-blur-in {
    animation: blurIn 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Scrolled state — always violet-950 */
  .navbar.is-scrolled {
    @apply bg-violet-950;
  }

  .navbar.is-scrolled .nav-link {
    color: oklch(0.746 0.085 274.039); /* violet-400 */
  }

  .navbar.is-scrolled .nav-link:hover {
    color: oklch(0.841 0.238 136.547); /* lime-400 */
  }

  .navbar.is-scrolled .logo-green {
    opacity: 1;
  }

  .navbar.is-scrolled .logo-purple {
    opacity: 0;
  }

  .navbar.is-scrolled .nav-logo {
    color: white;
  }

  .navbar.is-scrolled :global(.nav-btn) {
    background-color: oklch(76.81% 0.198 135.54); /* lime-500 */
    color: oklch(0.208 0.042 264.695); /* violet-950 */
  }

  .navbar.is-scrolled :global(.nav-btn:hover) {
    background-color: oklch(0.768 0.233 130.85); /* lime-500 */
  }

  .navbar.is-scrolled .hamburger-line {
    background-color: white;
  }

  .navbar.is-scrolled .mobile-nav-link {
    color: oklch(0.746 0.085 274.039); /* violet-400 */
  }

  .navbar.is-scrolled .mobile-nav-link:hover {
    color: oklch(0.841 0.238 136.547); /* lime-400 */
  }

  /* Hamburger open state — 2 lines to X */
  .mobile-menu-toggle.is-open .hamburger-line:nth-child(1) {
    transform: translateY(5px) rotate(45deg);
  }
  .mobile-menu-toggle.is-open .hamburger-line:nth-child(2) {
    transform: translateY(-5px) rotate(-45deg);
  }

  /* When menu open, ensure navbar bg so hamburger is visible */
  .navbar.menu-open {
    @apply bg-violet-950;
  }

  .navbar.menu-open .hamburger-line {
    background-color: white;
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const navbar = document.querySelector(".navbar")!;
    const menuToggle = document.querySelector(".mobile-menu-toggle")!;
    const mobileMenu = document.querySelector(".mobile-menu")!;

    function updateNavbar() {
      if (window.scrollY > 20) {
        navbar.classList.add("is-scrolled", "backdrop-blur-md");
      } else {
        navbar.classList.remove("is-scrolled", "backdrop-blur-md");
      }
    }

    function openMenu() {
      menuToggle.classList.add("is-open");
      mobileMenu.classList.remove("hidden");
      mobileMenu.classList.add("flex");
      navbar.classList.add("menu-open");
      document.body.style.overflow = "hidden";
      menuToggle.setAttribute("aria-expanded", "true");
    }

    function closeMenu() {
      menuToggle.classList.remove("is-open");
      mobileMenu.classList.add("hidden");
      mobileMenu.classList.remove("flex");
      navbar.classList.remove("menu-open");
      document.body.style.overflow = "";
      menuToggle.setAttribute("aria-expanded", "false");
    }

    menuToggle.addEventListener("click", () => {
      menuToggle.classList.contains("is-open") ? closeMenu() : openMenu();
    });

    // Close mobile menu on link click
    mobileMenu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });

    window.addEventListener("scroll", updateNavbar, { passive: true });
    updateNavbar();
  });
</script>
