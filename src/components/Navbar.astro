---
import Image from "astro/components/Image.astro";
import Button from "./Button.astro";
const navLinks = [
  { label: "Σχετικά", href: "/about" },
  { label: "Υπηρεσίες", href: "/services" },
  { label: "Συχνές ερωτήσεις", href: "/faq" },
  { label: "Επικοινωνία", href: "/contact" },
];
---

<header
  class="navbar fixed top-0 left-0 right-0 px-4 md:px-10 py-3 z-50 transition-all duration-500 animate-nav-drop opacity-0"
  style="animation-fill-mode: forwards;"
>
  <nav class="flex items-center justify-between">
    <a
      href="/"
      class="relative flex flex-col hover:opacity-80 transition-opacity"
    >
      <!-- green (original) — shown when scrolled -->
      <Image
        src="/logo.png"
        alt="Logo"
        width={150}
        height={150}
        class="logo-green opacity-0 transition-opacity duration-500 filter-[hue-rotate(90deg)_saturate(1)_brightness(1)_contrast(0.6)]"
      />
      <!-- purple — shown when at top -->
      <Image
        src="/logo.png"
        alt=""
        width={150}
        height={150}
        class="logo-purple absolute inset-0 filter-[hue-rotate(100deg)_saturate(2)_brightness(0.6)_contrast(1.2)] opacity-100 transition-opacity duration-500"
      />
    </a>

    <ul class="hidden lg:flex items-center self-stretch gap-8 lg:pl-8">
      {
        navLinks.map((link, i) => (
          <li
            class="animate-blur-in opacity-0"
            style={`animation-delay: ${0.2 + i * 0.1}s; animation-fill-mode: forwards;`}
          >
            <a
              href={link.href}
              class="nav-link text-dark-900 hover:text-primary-700 transition-colors duration-500 tracking-wide text-base font-medium h-full flex items-center px-10"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-4">
      <div
        class="hidden md:block animate-blur-in opacity-0"
        style="animation-delay: 0.8s; animation-fill-mode: forwards;"
      >
        <Button href="/booking" variant="nav">Δωρεάν συνεδρία γνωριμίας</Button>
      </div>

      <!-- Mobile hamburger -->
      <button
        class="mobile-menu-toggle lg:hidden flex flex-col items-center justify-center w-11 h-11 gap-2 cursor-pointer"
        aria-label="Μενού πλοήγησης"
        aria-expanded="false"
      >
        <span
          class="hamburger-line w-8 h-0.5 bg-dark-950 transition-all duration-300 origin-center"
        ></span>
        <span
          class="hamburger-line w-8 h-0.5 bg-dark-950 transition-all duration-300 origin-center"
        ></span>
      </button>
    </div>
  </nav>
</header>

<!-- Fullscreen mobile menu -->
<div
  class="mobile-menu fixed inset-0 z-40 bg-dark-900 lg:hidden flex flex-col justify-center items-center opacity-0 pointer-events-none transition-all duration-400 ease-out"
>
  <ul class="flex flex-col items-center gap-2">
    {
      navLinks.map((link, i) => (
        <li
          class="mobile-menu-item trandark-y-4 opacity-0"
          style={`transition-delay: ${80 + i * 60}ms;`}
        >
          <a
            href={link.href}
            class="mobile-nav-link block py-3 px-4 text-2xl font-semibold text-primary-300 hover:text-accent-300 transition-colors duration-300"
          >
            {link.label}
          </a>
        </li>
      ))
    }
    <li
      class="mobile-menu-item pt-6 trandark-y-4 opacity-0"
      style={`transition-delay: ${80 + navLinks.length * 60}ms;`}
    >
      <Button
        href="/booking"
        variant="nav"
        className="text-center justify-center px-10 py-3"
        >Δωρεάν συνεδρία γνωριμίας</Button
      >
    </li>
  </ul>
</div>

<style>
  @reference "../styles/global.css";
  @keyframes navDrop {
    from {
      transform: translateY(-20px);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  @keyframes blurIn {
    from {
      filter: blur(8px);
      opacity: 0;
      transform: translateY(5px);
    }
    to {
      filter: blur(0);
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-nav-drop {
    animation: navDrop 1s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .animate-blur-in {
    animation: blurIn 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Scrolled state */
  .navbar.is-scrolled {
    @apply bg-dark-900;
  }

  .navbar.is-scrolled .nav-link {
    color: var(--color-primary-300);
  }

  .navbar.is-scrolled .nav-link:hover {
    color: var(--color-accent-300);
  }

  .navbar.is-scrolled .logo-green {
    opacity: 1;
  }

  .navbar.is-scrolled .logo-purple {
    opacity: 0;
  }

  .navbar.is-scrolled .nav-logo {
    color: white;
  }

  .navbar.is-scrolled :global(.nav-btn) {
    background-color: var(--color-primary-700);
    color: white;
  }

  .navbar.is-scrolled :global(.nav-btn:hover) {
    background-color: var(--color-primary-800);
  }

  .navbar.is-scrolled .hamburger-line {
    background-color: white;
  }

  .navbar.is-scrolled .mobile-nav-link {
    color: var(--color-primary-300);
  }

  .navbar.is-scrolled .mobile-nav-link:hover {
    color: var(--color-accent-300);
  }

  /* Hamburger open state — 2 lines to X */
  .mobile-menu-toggle.is-open .hamburger-line:nth-child(1) {
    transform: translateY(5px) rotate(45deg);
  }
  .mobile-menu-toggle.is-open .hamburger-line:nth-child(2) {
    transform: translateY(-5px) rotate(-45deg);
  }

  /* When menu open, ensure navbar bg so hamburger is visible */
  .navbar.menu-open {
    @apply bg-dark-900;
  }

  .navbar.menu-open .hamburger-line {
    background-color: white;
  }

  /* Mobile menu transitions */
  .mobile-menu.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-menu-item {
    transition: opacity 0.35s ease-out, transform 0.35s ease-out;
  }

  .mobile-menu.is-open .mobile-menu-item {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const navbar = document.querySelector(".navbar")!;
    const menuToggle = document.querySelector(".mobile-menu-toggle")!;
    const mobileMenu = document.querySelector(".mobile-menu")!;

    function updateNavbar() {
      if (window.scrollY > 20) {
        navbar.classList.add("is-scrolled", "backdrop-blur-md");
      } else {
        navbar.classList.remove("is-scrolled", "backdrop-blur-md");
      }
    }

    function openMenu() {
      menuToggle.classList.add("is-open");
      mobileMenu.classList.add("is-open");
      navbar.classList.add("menu-open");
      document.body.style.overflow = "hidden";
      menuToggle.setAttribute("aria-expanded", "true");
    }

    function closeMenu() {
      menuToggle.classList.remove("is-open");
      mobileMenu.classList.remove("is-open");
      navbar.classList.remove("menu-open");
      document.body.style.overflow = "";
      menuToggle.setAttribute("aria-expanded", "false");
    }

    menuToggle.addEventListener("click", () => {
      menuToggle.classList.contains("is-open") ? closeMenu() : openMenu();
    });

    // Close mobile menu on link click
    mobileMenu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });

    window.addEventListener("scroll", updateNavbar, { passive: true });
    updateNavbar();
  });
</script>
