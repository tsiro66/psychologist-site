<script>
  const MAP_KEY = "AIzaSyBwzWx-pgqvVGvlXih2ShecZeJzYe23TmM";
  const MAP_LAT = 37.93105398341229;
  const MAP_LNG = 23.756774723212008;

  const darkBlueStyles = [
    { elementType: "geometry", stylers: [{ color: "#0b1a3a" }] },
    { elementType: "labels.text.stroke", stylers: [{ color: "#0b1a3a" }] },
    { elementType: "labels.text.fill", stylers: [{ color: "#8aa4d6" }] },
    { featureType: "administrative.locality", elementType: "labels.text.fill", stylers: [{ color: "#9fb6e6" }] },
    { featureType: "administrative.neighborhood", elementType: "labels.text.fill", stylers: [{ color: "#7f9bd4" }] },
    { featureType: "poi", elementType: "labels.text.fill", stylers: [{ color: "#7f9bd4" }] },
    { featureType: "poi.park", elementType: "geometry", stylers: [{ color: "#102a52" }] },
    { featureType: "road", elementType: "geometry", stylers: [{ color: "#15264f" }] },
    { featureType: "road.highway", elementType: "geometry", stylers: [{ color: "#1c3470" }] },
    { featureType: "road.highway", elementType: "labels.text.fill", stylers: [{ color: "#a9c0ee" }] },
    { featureType: "road.arterial", elementType: "labels.text.fill", stylers: [{ color: "#8aa4d6" }] },
    { featureType: "road.local", elementType: "labels.text.fill", stylers: [{ color: "#6f88bf" }] },
    { featureType: "transit", elementType: "geometry", stylers: [{ color: "#15264f" }] },
    { featureType: "transit.station", elementType: "labels.text.fill", stylers: [{ color: "#8aa4d6" }] },
    { featureType: "water", elementType: "geometry", stylers: [{ color: "#0a152e" }] },
    { featureType: "water", elementType: "labels.text.fill", stylers: [{ color: "#4a6699" }] },
  ];

  let loaded = false;
  let mapEl: HTMLElement | null = null;

  function renderMap() {
    if (!mapEl || !(window as any).google?.maps) return;
    const map = new (window as any).google.maps.Map(mapEl, {
      center: { lat: MAP_LAT, lng: MAP_LNG },
      zoom: 15,
      styles: darkBlueStyles,
      disableDefaultUI: true,
      zoomControl: true,
      gestureHandling: "cooperative",
    });
    new (window as any).google.maps.Marker({
      position: { lat: MAP_LAT, lng: MAP_LNG },
      map,
      title: "Κατερίνα Κρητικού",
    });
  }

  function loadMapsApi() {
    if (loaded) { renderMap(); return; }
    loaded = true;
    (window as any).initFooterMap = renderMap;
    const s = document.createElement("script");
    s.src = `https://maps.googleapis.com/maps/api/js?key=${MAP_KEY}&callback=initFooterMap&language=el&region=GR`;
    s.async = true;
    s.defer = true;
    document.head.appendChild(s);
  }

  function setup() {
    mapEl = document.getElementById("footer-map");
    if (!mapEl) return;
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            loadMapsApi();
            io.disconnect();
          }
        });
      },
      { rootMargin: "200px" }
    );
    io.observe(mapEl);
  }

  document.addEventListener("astro:page-load", setup);
</script>
