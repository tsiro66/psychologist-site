---
import Button from "./Button.astro";

const contactInfo = [
  {
    icon: "phone",
    label: "Τηλέφωνο",
    value: "+30 697 421 0321",
    href: "tel:+306974210321",
  },
  {
    icon: "email",
    label: "Email",
    value: "katkritikou1968@gmail.com",
    href: "mailto:katkritikou1968@gmail.com",
  },
  {
    icon: "location",
    label: "Διεύθυνση",
    value: "Βύρωνος 13 (2ος όροφος, εντός του εμπορικού κέντρου), ΗΛΙΟΥΠΟΛΗ 16342",
    href: "https://maps.app.goo.gl/YvLzjySg75LaQXCb8",
  },
  {
    icon: "clock",
    label: "Ωράριο",
    value: "Δευ–Πεμ: 08:30–12:30, 18:30–22:30\nΠαρ: 08:30–13:30, 15:30–22:30\nΣαβ: 10:30–14:30\nΚυρ: Κλειστά",
    href: null,
  },
];
---

<section id="contact" class="relative py-16 md:py-28 px-4 md:px-6 bg-primary-50">
  <div class="max-w-6xl mx-auto">
    <!-- Section Header -->
    <div class="mb-16">
      <span
        class="inline-block text-sm tracking-widest uppercase text-primary-600 font-semibold mb-4 contact-reveal opacity-0"
      >
        Επικοινωνία
      </span>
      <h2
        class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-serif text-neutral-950 leading-tight contact-reveal opacity-0"
        style="animation-delay: 0.1s;"
      >
        Ας <span class="text-primary-700 italic">μιλήσουμε</span>
      </h2>
      <p
        class="mt-5 text-neutral-500 max-w-2xl leading-relaxed contact-reveal opacity-0"
        style="animation-delay: 0.2s;"
      >
        Κάνε το πρώτο βήμα σήμερα. Στείλε μου μήνυμα ή κάλεσέ με για να
        κλείσουμε το ραντεβού σου.
      </p>
    </div>

    <!-- Two-column layout -->
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-10">
      <!-- Contact Form -->
      <div
        class="lg:col-span-3 flex flex-col bg-white p-5 sm:p-8 md:p-10 border border-stone-200 shadow-xl shadow-stone-200/60 contact-reveal opacity-0"
        style="animation-delay: 0.25s;"
      >
        <form id="contact-form" class="flex flex-col h-full">
          <div class="space-y-6 flex-1">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label
                for="name"
                class="block text-sm font-medium text-neutral-950 mb-2"
              >
                Όνομα
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                placeholder="Το όνομά σου"
                class="field-input w-full px-4 py-3 bg-white border border-stone-200 text-sm text-neutral-950 placeholder:text-neutral-400 outline-none focus:border-primary-400 focus:ring-2 focus:ring-primary-100 transition-all duration-300"
              />
              <span class="field-error hidden mt-1 text-xs text-red-600"></span>
            </div>
            <div>
              <label
                for="email"
                class="block text-sm font-medium text-neutral-950 mb-2"
              >
                Email
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="Το email σου"
                class="field-input w-full px-4 py-3 bg-white border border-stone-200 text-sm text-neutral-950 placeholder:text-neutral-400 outline-none focus:border-primary-400 focus:ring-2 focus:ring-primary-100 transition-all duration-300"
              />
              <span class="field-error hidden mt-1 text-xs text-red-600"></span>
            </div>
          </div>

          <div>
            <label
              for="phone"
              class="block text-sm font-medium text-neutral-950 mb-2"
            >
              Τηλέφωνο
              <span class="text-neutral-400 font-normal">(προαιρετικό)</span>
            </label>
            <input
              type="tel"
              id="phone"
              name="phone"
              placeholder="Το τηλέφωνό σου"
              class="field-input w-full px-4 py-3 bg-white border border-stone-200 text-sm text-neutral-950 placeholder:text-neutral-400 outline-none focus:border-primary-400 focus:ring-2 focus:ring-primary-100 transition-all duration-300"
            />
            <span class="field-error hidden mt-1 text-xs text-red-600"></span>
          </div>



          <div class="flex-1 flex flex-col">
            <label
              for="message"
              class="block text-sm font-medium text-neutral-950 mb-2"
            >
              Μήνυμα
            </label>
            <textarea
              id="message"
              name="message"
              required
              placeholder="Πες μου λίγα λόγια για εσένα και τι σε απασχολεί..."
              class="field-input w-full px-4 py-3 bg-white border border-stone-200 text-sm text-neutral-950 placeholder:text-neutral-400 outline-none focus:border-primary-400 focus:ring-2 focus:ring-primary-100 transition-all duration-300 resize-none flex-1 min-h-0"
            ></textarea>
            <span class="field-error hidden mt-1 text-xs text-red-600"></span>
          </div>

          </div>
          <div id="form-status" class="hidden text-sm p-3 rounded mt-4"></div>
          <Button type="submit" variant="primary" className="w-full text-center justify-center py-3.5 mt-6">
            <span id="btn-text">Αποστολή μηνύματος</span>
          </Button>
        </form>
      </div>

      <!-- Contact Info Sidebar -->
      <div class="lg:col-span-2 flex flex-col gap-5">
        {
          contactInfo.map((info, i) => (
            <a
              href={info.href ?? undefined}
              target={info.href?.startsWith("http") ? "_blank" : undefined}
              rel={info.href?.startsWith("http") ? "noopener noreferrer" : undefined}
              class:list={[
                "group flex items-start gap-5 p-6 border border-stone-200 bg-white shadow-md shadow-stone-200/50 transition-all duration-500 hover:border-primary-300 hover:shadow-lg hover:shadow-primary-100/60 contact-reveal opacity-0",
                !info.href && "pointer-events-none",
              ]}
              style={`animation-delay: ${0.3 + i * 0.1}s;`}
            >
              <div class="w-11 h-11 rounded-xl bg-primary-100 flex items-center justify-center flex-shrink-0 group-hover:bg-accent-100 transition-colors duration-500">
                {info.icon === "phone" && (
                  <svg class="w-5 h-5 text-primary-500 group-hover:text-primary-600 transition-colors duration-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
                  </svg>
                )}
                {info.icon === "email" && (
                  <svg class="w-5 h-5 text-primary-500 group-hover:text-primary-600 transition-colors duration-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
                  </svg>
                )}
                {info.icon === "location" && (
                  <svg class="w-5 h-5 text-primary-500 group-hover:text-primary-600 transition-colors duration-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
                  </svg>
                )}
                {info.icon === "clock" && (
                  <svg class="w-5 h-5 text-primary-500 group-hover:text-primary-600 transition-colors duration-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                  </svg>
                )}
              </div>
              <div>
                <span class="block text-xs text-neutral-400 uppercase tracking-wider mb-1">
                  {info.label}
                </span>
                <span class="text-sm font-medium text-neutral-950 whitespace-pre-line">
                  {info.value}
                </span>
              </div>
            </a>
          ))
        }

        <!-- Social / CTA card -->
        <div
          class="p-6 bg-gradient-to-br from-primary-700 to-dark-800 text-white shadow-xl shadow-primary-300/30 contact-reveal opacity-0"
          style="animation-delay: 0.75s;"
        >
          <h3 class="font-semibold text-lg mb-2">Φέρε την ισορροπία στο σώμα και στο νου σου</h3>
          <p class="text-sm text-primary-200 leading-relaxed">
            Επικοινώνησε μαζί μου. Είμαι εδώ για να σου προσφέρω έναν ασφαλή
            χώρο (online ή δια ζώσης) και να περπατήσουμε μαζί τη διαδρομή σου.
          </p>
          <Button href="/booking" variant="nav" className="mt-4">Κλείσε ραντεβού</Button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes contactReveal {
    from {
      filter: blur(8px);
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      filter: blur(0);
      opacity: 1;
      transform: translateY(0);
    }
  }

  .contact-reveal.is-visible {
    animation: contactReveal 0.9s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .field-input.has-error {
    border-color: var(--color-red-400);
  }
  .field-input.has-error:focus {
    border-color: var(--color-red-400);
    --tw-ring-color: var(--color-red-100);
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const contactObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            contactObserver.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1 }
    );

    document.querySelectorAll(".contact-reveal").forEach((el) => {
      contactObserver.observe(el);
    });

    const formEl = document.getElementById("contact-form") as HTMLFormElement | null;
    const status = document.getElementById("form-status");
    const btnText = document.getElementById("btn-text");
    if (!formEl || !status || !btnText) return;
    const form = formEl;

    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    const phoneRegex = /^[+]?[\d\s\-().]{7,20}$/;

    function showFieldError(field: HTMLElement, msg: string) {
      field.classList.add("has-error");
      const err = field.parentElement?.querySelector(".field-error") as HTMLElement;
      if (err) {
        err.textContent = msg;
        err.classList.remove("hidden");
      }
    }

    function clearFieldError(field: HTMLElement) {
      field.classList.remove("has-error");
      const err = field.parentElement?.querySelector(".field-error") as HTMLElement;
      if (err) {
        err.textContent = "";
        err.classList.add("hidden");
      }
    }

    function validate(): boolean {
      let valid = true;
      const name = form.querySelector<HTMLInputElement>("#name")!;
      const email = form.querySelector<HTMLInputElement>("#email")!;
      const phone = form.querySelector<HTMLInputElement>("#phone")!;
      const message = form.querySelector<HTMLTextAreaElement>("#message")!;

      [name, email, phone, message].forEach(clearFieldError);

      if (!name.value.trim()) {
        showFieldError(name, "Το όνομα είναι υποχρεωτικό.");
        valid = false;
      }

      if (!email.value.trim()) {
        showFieldError(email, "Το email είναι υποχρεωτικό.");
        valid = false;
      } else if (!emailRegex.test(email.value.trim())) {
        showFieldError(email, "Μη έγκυρη διεύθυνση email.");
        valid = false;
      }

      if (phone.value.trim() && !phoneRegex.test(phone.value.trim())) {
        showFieldError(phone, "Μη έγκυρος αριθμός τηλεφώνου.");
        valid = false;
      }

      if (!message.value.trim()) {
        showFieldError(message, "Το μήνυμα είναι υποχρεωτικό.");
        valid = false;
      }

      return valid;
    }

    form.querySelectorAll<HTMLElement>(".field-input").forEach((field) => {
      field.addEventListener("input", () => clearFieldError(field));
    });

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      status.classList.add("hidden");

      if (!validate()) return;

      const data = Object.fromEntries(new FormData(form));
      btnText.textContent = "Αποστολή...";
      const btn = form.querySelector("button[type=submit]") as HTMLButtonElement;
      btn.disabled = true;

      try {
        const res = await fetch("/api/contact", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data),
        });
        const json = await res.json();

        if (!res.ok) {
          status.textContent = json.error || "Κάτι πήγε στραβά.";
          status.className = "text-sm p-3 rounded bg-red-50 text-red-700";
        } else {
          status.textContent = "Το μήνυμά σου στάλθηκε! Θα επικοινωνήσουμε σύντομα.";
          status.className = "text-sm p-3 rounded bg-green-50 text-green-700";
          form.reset();
        }
      } catch {
        status.textContent = "Σφάλμα δικτύου. Δοκίμασε ξανά.";
        status.className = "text-sm p-3 rounded bg-red-50 text-red-700";
      } finally {
        btnText.textContent = "Αποστολή μηνύματος";
        btn.disabled = false;
      }
    });
  });
</script>
