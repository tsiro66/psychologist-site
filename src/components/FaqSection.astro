---
const faqs = [
  {
    question: "Τι να περιμένω; — Η πρώτη συνεδρία",
    hint: "Η αρχή της διαδρομής",
    answer:
      "Η πρώτη μας συνεδρία είναι μια ολοκληρωμένη συνάντηση 60 λεπτών, όπου ακούω την ιστορία σου, χαρτογραφούμε τις ανάγκες σου και θέτουμε τις βάσεις για τη θεραπευτική σου διαδρομή, μέσα σε ένα περιβάλλον απόλυτης ασφάλειας και αποδοχής.",
  },
  {
    question: "Πώς λειτουργεί η θεραπευτική διαδικασία;",
    hint: "Τι περιλαμβάνει κάθε συνεδρία",
    answer:
      "Κάθε συνεδρία διαρκεί 60 λεπτά. Δεν θα βρεις έτοιμες συνταγές, αλλά θα μάθεις να ακούς τον εαυτό σου. Ανάλογα με τις ανάγκες σου θα εντάσσουμε ήπιες τεχνικές mindfulness ή αναπνοής, ώστε φεύγοντας να νιώθεις το μυαλό και το σώμα σου πιο ανάλαφρα.",
  },
  {
    question: "Είναι εμπιστευτικές οι συνεδρίες;",
    hint: "Απόλυτη εχεμυθία",
    answer:
      "Απόλυτα. Όσα μοιράζεσαι μαζί μου προστατεύονται αυστηρά από το επαγγελματικό απόρρητο. Ο χώρος μου είναι και θα παραμείνει ένα απόλυτο ασφαλές καταφύγιο για σένα.",
  },
  {
    question: "Πόση διάρκεια έχει μια συνεδρία;",
    hint: "Διάρκεια ανά τύπο υπηρεσίας",
    answer:
      "Οι ατομικές συνεδρίες διαρκούν 60 λεπτά και είναι αφιερωμένες σε εσένα. Η συμβουλευτική ζευγαριών διαρκεί 90 λεπτά ώστε να υπάρχει ο απαραίτητος χρόνος για να ακουστούν ισότιμα και οι δύο πλευρές και να στηριχτεί η διαδικασία.",
  },
  {
    question: "Οι συνεδρίες γίνονται και online;",
    hint: "Online και δια ζώσης επιλογές",
    answer: "Ναι, οι συνεδρίες γίνονται και online.",
  },
];
---

<section id="faq" class="relative py-16 md:py-28 px-4 md:px-6 bg-primary-50">
  <div class="max-w-6xl mx-auto">
    <!-- Section Header -->
    <div class="mb-20">
      <span
        class="inline-block text-sm tracking-widest uppercase text-primary-600 font-semibold mb-4 faq-reveal opacity-0"
      >
        Συχνές ερωτήσεις
      </span>
      <h2
        class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-serif text-neutral-950 leading-tight faq-reveal opacity-0"
        style="animation-delay: 0.1s;"
      >
        Έχεις <span class="text-primary-700 italic">απορίες;</span>
      </h2>
      <p
        class="mt-5 text-neutral-500 max-w-xl leading-relaxed faq-reveal opacity-0"
        style="animation-delay: 0.2s;"
      >
        Βρες απαντήσεις στις πιο συχνές ερωτήσεις σχετικά με τη θεραπεία και τον
        τρόπο λειτουργίας μας.
      </p>
    </div>

    <!-- FAQ Rows -->
    <div class="border-t border-stone-200">
      {
        faqs.map((faq, i) => (
          <div
            class="faq-row group border-b border-stone-200 faq-reveal opacity-0"
            style={`animation-delay: ${0.15 + i * 0.08}s;`}
          >
            <button
              class="faq-toggle w-full grid grid-cols-[1fr_auto] md:grid-cols-[1fr_1.5fr_auto] items-center gap-4 md:gap-8 py-5 md:py-7 text-left cursor-pointer"
              aria-expanded="false"
            >
              <h3 class="text-sm sm:text-base md:text-lg font-semibold text-neutral-950 group-hover:text-primary-600 transition-colors duration-300">
                {faq.question}
              </h3>
              <p class="hidden md:block text-sm text-neutral-500 leading-relaxed">
                {faq.hint}
              </p>
              <span class="faq-icon w-8 h-8 md:w-9 md:h-9 rounded-full border border-stone-300 flex items-center justify-center flex-shrink-0 group-hover:border-primary-400 transition-all duration-500">
                <svg
                  class="w-4 h-4 text-neutral-400 group-hover:text-primary-600 transition-all duration-500"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M12 4.5v15m7.5-7.5h-15"
                  />
                </svg>
              </span>
            </button>
            <div class="faq-content grid grid-rows-[0fr] transition-[grid-template-rows] duration-500 ease-[cubic-bezier(0.22,1,0.36,1)]">
              <div class="overflow-hidden">
                <p class="pb-7 text-sm text-neutral-500 leading-relaxed max-w-3xl">
                  {faq.answer}
                </p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style is:global>
  @keyframes faqReveal {
    from {
      filter: blur(8px);
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      filter: blur(0);
      opacity: 1;
      transform: translateY(0);
    }
  }

  .faq-reveal.is-visible {
    animation: faqReveal 0.9s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .faq-row.is-open .faq-content {
    grid-template-rows: 1fr;
  }

  .faq-row.is-open .faq-icon {
    border-color: var(--color-primary-600);
    background-color: var(--color-primary-600);
  }

  .faq-row.is-open .faq-icon svg {
    color: white;
    transform: rotate(45deg);
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const faqObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            faqObserver.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 }
    );

    document.querySelectorAll(".faq-reveal:not([data-faq-obs])").forEach((el) => {
      el.setAttribute("data-faq-obs", "");
      faqObserver.observe(el);
    });

    document.querySelectorAll(".faq-toggle:not([data-faq-bound])").forEach((btn) => {
      btn.setAttribute("data-faq-bound", "");
      btn.addEventListener("click", () => {
        const row = btn.closest(".faq-row")!;
        const isOpen = row.classList.contains("is-open");

        document.querySelectorAll(".faq-row.is-open").forEach((openRow) => {
          openRow.classList.remove("is-open");
          openRow.querySelector(".faq-toggle")?.setAttribute("aria-expanded", "false");
        });

        if (!isOpen) {
          row.classList.add("is-open");
          btn.setAttribute("aria-expanded", "true");
        }
      });
    });
  });
</script>
