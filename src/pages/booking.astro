---
import Calendar from "../components/Calendar.svelte";
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Κράτηση Ραντεβού">
  <section class="py-16 md:py-28 px-4 md:px-6 bg-stone-50 min-h-[80vh]">
    <div class="max-w-6xl mx-auto">
      <div class="mb-12 text-center">
        <span class="inline-block text-sm tracking-widest uppercase text-lime-600 font-semibold mb-4">
          Κρατηση
        </span>
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-serif text-neutral-950 leading-tight">
          Διάλεξε ημερομηνία & <span class="text-violet-600 italic">ώρα</span>
        </h1>
      </div>
      <Calendar client:load />
    </div>
  </section>
</MainLayout>
