---
import { Image } from "astro:assets";
import aboutImage from "../assets/about.png";
import HeroSection from "../components/HeroSection.astro";
import Button from "../components/Button.astro";
import MainLayout from "../layouts/MainLayout.astro";

const services = [
  "Ατομικές Συνεδρίες",
  "Συμβουλευτική Ζευγαριών & Σχέσεων",
  "Διαχείριση Κρίσεων Πανικού & Άγχους",
  "Mindfulness",
];

const faqs = [
  "Τι να περιμένω; — Η πρώτη συνεδρία",
  "Πόση διάρκεια έχει μια συνεδρία;",
  "Οι συνεδρίες γίνονται και online;",
];
---

<MainLayout
  title="Κατερίνα Κρητικού | Ψυχολόγος — Σύμβουλος Ψυχικής Υγείας"
  description="Κατερίνα Κρητικού — Σύμβουλος Ψυχικής Υγείας, Mindfulness Instructor & Yoga Teacher στην Ηλιούπολη. Ατομικές συνεδρίες, συμβουλευτική ζευγαριών, διαχείριση άγχους & κρίσεων πανικού."
>
  <HeroSection />

  <!-- About Preview -->
  <section class="py-16 md:py-28 px-4 md:px-6 bg-blue-100">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div>
          <span class="inline-block text-sm tracking-widest uppercase text-primary-600 font-semibold mb-4 home-reveal opacity-0">
            Σχετικά
          </span>
          <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-serif text-neutral-950 leading-tight mb-6 home-reveal opacity-0" style="animation-delay: 0.1s;">
            Λίγα λόγια <span class="text-primary-700 italic">για εμένα</span>
          </h2>
          <p class="text-base md:text-lg text-neutral-600 leading-relaxed mb-8 home-reveal opacity-0" style="animation-delay: 0.2s;">
            Καλώς ήρθες, είμαι η Κατερίνα Κρητικού. Πιστεύω βαθιά ότι η ψυχική ισορροπία δεν είναι η απουσία δυσκολιών, αλλά η ικανότητά μας να παραμένουμε σταθεροί και γαλήνιοι μέσα σε αυτές. Ως Σύμβουλος Ψυχικής Υγείας, Mindfulness Instructor και Yoga Teacher, η προσέγγισή μου είναι ολιστική.
          </p>
          <div class="home-reveal opacity-0" style="animation-delay: 0.3s;">
            <Button href="/about" variant="primary">Μάθε περισσότερα</Button>
          </div>
        </div>
        <div class="home-reveal opacity-0" style="animation-delay: 0.25s;">
          <Image
            src={aboutImage}
            alt="Κατερίνα Κρητικού"
            class="w-full aspect-[3/2] object-cover shadow-2xl shadow-stone-400/30"
            quality="high"
            width={700}
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Services Preview -->
  <section class="py-16 md:py-28 px-4 md:px-6 bg-blue-100">
    <div class="max-w-6xl mx-auto md:text-right">
      <span class="inline-block text-sm tracking-widest uppercase text-primary-600 font-semibold mb-4 home-reveal opacity-0">
        Υπηρεσίες
      </span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-serif text-neutral-950 leading-tight mb-12 home-reveal opacity-0" style="animation-delay: 0.1s;">
        Πώς θα <span class="text-primary-700 italic">δουλέψουμε μαζί</span>
      </h2>
      <div class="">
        {services.map((title, i) => (
          <div
            class="flex items-center justify-between gap-4 py-5 md:py-6 border-b border-primary-200 home-reveal opacity-0"
            style={`animation-delay: ${0.15 + i * 0.08}s;`}
          >
            <span class="text-base md:text-lg text-neutral-950">{title}</span>
          </div>
        ))}
      </div>
      <div class="mt-10 home-reveal opacity-0" style="animation-delay: 0.4s;">
        <Button href="/services" variant="primary">Δες όλες τις υπηρεσίες</Button>
      </div>
    </div>
  </section>

  <!-- FAQ Preview -->
  <section class="py-16 md:py-28 px-4 md:px-6 bg-blue-100">
    <div class="max-w-6xl mx-auto">
      <span class="inline-block text-sm tracking-widest uppercase text-primary-600 font-semibold mb-4 home-reveal opacity-0">
        Συχνές ερωτήσεις
      </span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-serif text-neutral-950 leading-tight mb-12 home-reveal opacity-0" style="animation-delay: 0.1s;">
        Έχεις <span class="text-primary-700 italic">απορίες;</span>
      </h2>
      <div class="">
        {faqs.map((question, i) => (
          <div
            class="flex items-center justify-between py-5 md:py-6 border-b border-primary-200 home-reveal opacity-0"
            style={`animation-delay: ${0.15 + i * 0.08}s;`}
          >
            <span class="text-base md:text-lg text-neutral-950">{question}</span>
          </div>
        ))}
      </div>
      <div class="mt-10 home-reveal opacity-0" style="animation-delay: 0.4s;">
        <Button href="/faq" variant="primary">Δες όλες τις ερωτήσεις</Button>
      </div>
    </div>
  </section>

  <!-- Contact CTA -->
  <section class="py-16 md:py-28 px-4 md:px-6 bg-dark-900">
    <div class="max-w-6xl mx-auto text-center home-reveal opacity-0">
      <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-serif text-white leading-tight mb-6">
        Κάνε το πρώτο <span class="text-accent-300 italic">βήμα</span>
      </h2>
      <p class="text-base md:text-lg text-primary-200 leading-relaxed max-w-2xl mx-auto mb-10">
        Φέρε την ισορροπία στο σώμα και στο νου σου. Επικοινώνησε μαζί μου.
      </p>
      <Button href="/contact" variant="primary">Επικοινώνησε μαζί μου</Button>
    </div>
  </section>
</MainLayout>

<style>
  @keyframes homeReveal {
    from {
      filter: blur(8px);
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      filter: blur(0);
      opacity: 1;
      transform: translateY(0);
    }
  }

  .home-reveal.is-visible {
    animation: homeReveal 0.9s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const homeObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            homeObserver.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1 }
    );

    document.querySelectorAll(".home-reveal").forEach((el) => {
      homeObserver.observe(el);
    });
  });
</script>