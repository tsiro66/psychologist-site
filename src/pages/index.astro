---
import { Image } from "astro:assets";
import aboutImage from "../assets/about.png";
import HeroSection from "../components/HeroSection.astro";
import Button from "../components/Button.astro";
import MainLayout from "../layouts/MainLayout.astro";

const services = [
  "Ατομικές και Ομαδικές Συνεδρίες",
  "Συμβουλευτική Ζευγαριών, Γονέων και Εφήβων",
  "Υποστήριξη Προσωπικής Ανάπτυξης και ΛΟΑΤΚΙ+ Ατόμων",
];

const faqs = [
  "Πώς ξέρω αν χρειάζομαι ψυχοθεραπεία;",
  "Πόσο διαρκεί μια συνεδρία;",
  "Οι συνεδρίες γίνονται και διαδικτυακά;",
];
---

<MainLayout title="Κατερίνα Κρητικού | Ψυχολόγος">
  <HeroSection />

  <!-- About Preview -->
  <section class="py-16 md:py-28 px-4 md:px-6 bg-stone-50">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div>
          <span class="inline-block text-sm tracking-widest uppercase text-lime-600 font-semibold mb-4 home-reveal opacity-0">
            Σχετικα
          </span>
          <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-serif text-neutral-950 leading-tight mb-6 home-reveal opacity-0" style="animation-delay: 0.1s;">
            Λίγα λόγια <span class="text-violet-600 italic">για εμένα</span>
          </h2>
          <p class="text-base md:text-lg text-neutral-600 leading-relaxed mb-8 home-reveal opacity-0" style="animation-delay: 0.2s;">
            Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.
          </p>
          <div class="home-reveal opacity-0" style="animation-delay: 0.3s;">
            <Button href="/about" variant="primary">Μάθε περισσότερα</Button>
          </div>
        </div>
        <div class="home-reveal opacity-0" style="animation-delay: 0.25s;">
          <Image
            src={aboutImage}
            alt="Κατερίνα Κρητικού"
            class="w-full aspect-[3/2] object-cover shadow-2xl shadow-stone-400/30"
            quality="high"
            width={700}
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Services Preview -->
  <section class="py-16 md:py-28 px-4 md:px-6 bg-stone-50 border-t border-stone-200">
    <div class="max-w-6xl mx-auto md:text-right">
      <span class="inline-block text-sm tracking-widest uppercase text-lime-600 font-semibold mb-4 home-reveal opacity-0">
        Υπηρεσιες
      </span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-serif text-neutral-950 leading-tight mb-12 home-reveal opacity-0" style="animation-delay: 0.1s;">
        Πώς μπορούμε να <span class="text-violet-600 italic">βοηθήσουμε</span>
      </h2>
      <div class="border-t border-stone-200">
        {services.map((title, i) => (
          <div
            class="flex items-center justify-between gap-4 py-5 md:py-6 border-b border-stone-200 home-reveal opacity-0"
            style={`animation-delay: ${0.15 + i * 0.08}s;`}
          >
            <span class="text-base md:text-lg font-semibold text-neutral-950">{title}</span>
            <svg class="w-5 h-5 text-neutral-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
            </svg>
          </div>
        ))}
      </div>
      <div class="mt-10 home-reveal opacity-0" style="animation-delay: 0.4s;">
        <Button href="/services" variant="primary">Δες όλες τις υπηρεσίες</Button>
      </div>
    </div>
  </section>

  <!-- FAQ Preview -->
  <section class="py-16 md:py-28 px-4 md:px-6 bg-stone-50 border-t border-stone-200">
    <div class="max-w-6xl mx-auto">
      <span class="inline-block text-sm tracking-widest uppercase text-lime-600 font-semibold mb-4 home-reveal opacity-0">
        Συχνες ερωτησεις
      </span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-serif text-neutral-950 leading-tight mb-12 home-reveal opacity-0" style="animation-delay: 0.1s;">
        Έχεις <span class="text-violet-600 italic">απορίες;</span>
      </h2>
      <div class="border-t border-stone-200">
        {faqs.map((question, i) => (
          <div
            class="flex items-center justify-between py-5 md:py-6 border-b border-stone-200 home-reveal opacity-0"
            style={`animation-delay: ${0.15 + i * 0.08}s;`}
          >
            <span class="text-base md:text-lg text-neutral-950">{question}</span>
            <svg class="w-5 h-5 text-neutral-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
            </svg>
          </div>
        ))}
      </div>
      <div class="mt-10 home-reveal opacity-0" style="animation-delay: 0.4s;">
        <Button href="/faq" variant="primary">Δες όλες τις ερωτήσεις</Button>
      </div>
    </div>
  </section>

  <!-- Contact CTA -->
  <section class="py-16 md:py-28 px-4 md:px-6 bg-violet-950">
    <div class="max-w-6xl mx-auto text-center home-reveal opacity-0">
      <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-serif text-white leading-tight mb-6">
        Κάνε το πρώτο <span class="text-lime-400 italic">βήμα</span>
      </h2>
      <p class="text-base md:text-lg text-violet-300 leading-relaxed max-w-2xl mx-auto mb-10">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.
      </p>
      <Button href="/contact" variant="primary">Επικοινώνησε μαζί μας</Button>
    </div>
  </section>
</MainLayout>

<style>
  @keyframes homeReveal {
    from {
      filter: blur(8px);
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      filter: blur(0);
      opacity: 1;
      transform: translateY(0);
    }
  }

  .home-reveal.is-visible {
    animation: homeReveal 0.9s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const homeObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            homeObserver.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1 }
    );

    document.querySelectorAll(".home-reveal").forEach((el) => {
      homeObserver.observe(el);
    });
  });
</script>