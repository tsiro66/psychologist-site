---
import "../../styles/global.css";
import { Font } from "astro:assets";

export const prerender = false;

if (Astro.locals.user) {
  return Astro.redirect("/admin/bookings");
}
---

<html lang="el">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-google" />
    <Font cssVariable="--font-source-serif" />
    <title>Σύνδεση</title>
  </head>
  <body class="min-h-screen bg-stone-50 flex items-center justify-center px-4 py-12">
    <main class="w-full max-w-md">
      <div class="mb-10 text-center">
        <div class="inline-flex items-center justify-center size-14 rounded-full bg-primary-50 border border-primary-100 mb-5">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="size-6 text-primary-700"
            viewBox="0 0 20 20"
            fill="currentColor"
          >
            <path
              fill-rule="evenodd"
              d="M10 1a4.5 4.5 0 00-4.5 4.5V9H5a2 2 0 00-2 2v6a2 2 0 002 2h10a2 2 0 002-2v-6a2 2 0 00-2-2h-.5V5.5A4.5 4.5 0 0010 1zm3 8V5.5a3 3 0 10-6 0V9h6z"
              clip-rule="evenodd"></path>
          </svg>
        </div>
        <h1 class="text-3xl sm:text-4xl font-serif text-neutral-950 leading-tight">
          <span class="text-primary-700 italic">Σύνδεση</span>
        </h1>
        <p class="text-sm text-neutral-500 mt-2">Πίνακας διαχείρισης</p>
      </div>

      <div class="bg-white border border-stone-200 rounded-sm p-8 shadow-sm">
        <form id="login-form" class="space-y-5" novalidate>
          <div>
            <label for="email" class="block text-sm font-medium text-neutral-700 mb-1.5">
              Email
            </label>
            <input
              id="email"
              type="email"
              autocomplete="email"
              required
              class="w-full px-4 py-3 text-sm bg-white border border-stone-200 rounded-sm text-neutral-950 outline-none focus:border-primary-500 focus:ring-2 focus:ring-primary-100 transition-all disabled:opacity-60 disabled:cursor-not-allowed"
            />
          </div>
          <div>
            <label for="password" class="block text-sm font-medium text-neutral-700 mb-1.5">
              Κωδικός
            </label>
            <input
              id="password"
              type="password"
              autocomplete="current-password"
              required
              class="w-full px-4 py-3 text-sm bg-white border border-stone-200 rounded-sm text-neutral-950 outline-none focus:border-primary-500 focus:ring-2 focus:ring-primary-100 transition-all disabled:opacity-60 disabled:cursor-not-allowed"
            />
          </div>

          <div
            id="error-msg"
            class="hidden flex items-start gap-2 px-3 py-2.5 bg-red-50 border border-red-200 rounded-sm text-sm text-red-700"
            role="alert"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="size-4 mt-0.5 shrink-0"
              viewBox="0 0 20 20"
              fill="currentColor"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z"
                clip-rule="evenodd"></path>
            </svg>
            <span id="error-text">Λάθος email ή κωδικός</span>
          </div>

          <button
            id="submit-btn"
            type="submit"
            class="w-full py-3 px-7 text-sm font-semibold bg-primary-700 text-white hover:bg-primary-800 transition-colors duration-200 cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed inline-flex items-center justify-center gap-2"
          >
            <svg
              id="spinner"
              xmlns="http://www.w3.org/2000/svg"
              class="hidden size-4 animate-spin"
              viewBox="0 0 24 24"
              fill="none"
            >
              <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" stroke-opacity="0.25"></circle>
              <path d="M22 12a10 10 0 01-10 10" stroke="currentColor" stroke-width="3" stroke-linecap="round"></path>
            </svg>
            <span id="submit-label">Είσοδος</span>
          </button>
        </form>
      </div>

      <p class="text-center text-xs text-neutral-400 mt-6">
        <a href="/" class="hover:text-neutral-600 transition-colors">← Επιστροφή στην ιστοσελίδα</a>
      </p>
    </main>

    <script>
      const form = document.getElementById("login-form") as HTMLFormElement;
      const errorBox = document.getElementById("error-msg")!;
      const errorText = document.getElementById("error-text")!;
      const email = document.getElementById("email") as HTMLInputElement;
      const password = document.getElementById("password") as HTMLInputElement;
      const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
      const submitLabel = document.getElementById("submit-label")!;
      const spinner = document.getElementById("spinner")!;

      function setLoading(loading: boolean) {
        submitBtn.disabled = loading;
        email.disabled = loading;
        password.disabled = loading;
        submitLabel.textContent = loading ? "Σύνδεση..." : "Είσοδος";
        spinner.classList.toggle("hidden", !loading);
      }

      function showError(msg: string) {
        errorText.textContent = msg;
        errorBox.classList.remove("hidden");
      }

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        errorBox.classList.add("hidden");

        if (!email.value || !password.value) {
          showError("Συμπλήρωσε email και κωδικό");
          return;
        }

        setLoading(true);
        try {
          const res = await fetch("/api/admin-login", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ email: email.value, password: password.value }),
          });

          if (!res.ok) {
            const data = await res.json().catch(() => ({}));
            showError(data.error || "Λάθος email ή κωδικός");
            setLoading(false);
            return;
          }

          window.location.href = "/admin/bookings";
        } catch {
          showError("Σφάλμα δικτύου. Δοκίμασε ξανά.");
          setLoading(false);
        }
      });
    </script>
  </body>
</html>
