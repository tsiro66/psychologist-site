---
import AdminLayout from "../../layouts/AdminLayout.astro";
import BookingsAdmin from "../../components/BookingsAdmin.svelte";

export const prerender = false;
---

<AdminLayout title="Διαχείριση Κρατήσεων">
  <section class="py-16 md:py-28 px-4 md:px-6 bg-stone-50 min-h-screen">
    <div class="max-w-6xl mx-auto">
      <div class="mb-12 text-center">
        <span class="inline-block text-sm tracking-widest uppercase text-primary-600 font-semibold mb-4">
          Διαχειριση
        </span>
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-serif text-neutral-950 leading-tight">
          Οι <span class="text-primary-700 italic">κρατήσεις</span> σου
        </h1>
      </div>
      <BookingsAdmin client:idle />
    </div>
  </section>
</AdminLayout>
