---
import MainLayout from "../layouts/MainLayout.astro";
import Button from "../components/Button.astro";
---

<MainLayout title="404 — Η σελίδα δεν βρέθηκε" navbarScrolled noindex>
  <section class="flex items-center justify-center min-h-screen px-4 md:px-6 text-center">
    <div class="max-w-2xl mx-auto">
      <span class="text-8xl md:text-9xl font-serif font-bold text-primary-700 leading-none select-none">
        404
      </span>
      <h1 class="text-2xl sm:text-3xl md:text-4xl font-serif text-white mt-6 mb-4">
        Η σελίδα δεν <span class="text-accent-300 italic">βρέθηκε</span>
      </h1>
      <p class="text-base md:text-lg text-primary-200 leading-relaxed mb-10 max-w-md mx-auto">
        Η σελίδα που ψάχνεις δεν υπάρχει ή έχει μετακινηθεί.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button href="/" variant="primary">Αρχική σελίδα</Button>
        <Button href="/contact" variant="secondary">Επικοινωνία</Button>
      </div>
    </div>
  </section>
</MainLayout>
